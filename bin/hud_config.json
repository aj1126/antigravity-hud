{
  "lines": 3,
  "two_line": true,
  "separator": "│",
  "compact_mode": "short",
  "line1": [
    "workspace",
    "git_status",
    "model",
    "state"
  ],
  "line2": [
    "context",
    "fork",
    "quota_5h",
    "quota_weekly"
  ],
  "line3": [
    "mcp",
    "subagents",
    "tasks",
    "artifacts",
    "queue"
  ],
  "line4": [
    "auth",
    "sandbox",
    "session"
  ],
  "disabled": [
    "plan_tier",
    "credits"
  ],
  "item_styles": {},
  "session_uptime": {
    "show_seconds": false,
    "thresholds": [
      {
        "max_minutes": 10,
        "color": "green"
      },
      {
        "max_minutes": 30,
        "color": "yellow"
      },
      {
        "max_minutes": null,
        "color": "red"
      }
    ]
  },
  "fork_advisory": {
    "enabled": true,
    "require_clean_git": true,
    "warning_percent": 60,
    "alert_percent": 75,
    "critical_percent": 90,
    "step_warning": 300,
    "step_alert": 500,
    "step_critical": 800
  }
}